mapscripts RemusPokemonCenter_MapScripts {

}

script RemusPokemonCenter_EventScript_Clerk {
    lock
    faceplayer
    message(gText_HowMayIServeYou)
    waitmessage
    pokemart(Remus_Mart_Pokemart)
    message(gText_PleaseComeAgain)
    waitmessage
    waitbuttonpress
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
    waitmovement(0)
    release
}

mart Remus_Mart_Pokemart {
    ITEM_POKE_BALL
    ITEM_POTION
}